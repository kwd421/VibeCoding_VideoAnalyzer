Dialogue: 0,0:00:00.10,0:00:00.93,Default,,0,0,0,,아리사가 만약에
Dialogue: 0,0:00:00.98,0:00:01.82,Default,,0,0,0,,유치원을 연다면
Dialogue: 0,0:00:01.87,0:00:02.73,Default,,0,0,0,,내가 뭔가 가르쳐줄
Dialogue: 0,0:00:02.78,0:00:03.83,Default,,0,0,0,,만한 게 뭐가 있을까?
Dialogue: 0,0:00:03.87,0:00:05.83,Default,,0,0,0,,내가 원장이 될 만한 거
Dialogue: 0,0:00:05.87,0:00:07.20,Default,,0,0,0,,아니 상례하는 분 말고
Dialogue: 0,0:00:07.25,0:00:08.41,Default,,0,0,0,,수구마기 말고
Dialogue: 0,0:00:08.88,0:00:09.25,Default,,0,0,0,,뭐 없을까?
Dialogue: 0,0:00:09.30,0:00:12.46,Default,,0,0,0,,아이 그거 말고
Dialogue: 0,0:00:12.51,0:00:13.30,Default,,0,0,0,,피아스 하는 거?
Dialogue: 0,0:00:13.35,0:00:14.38,Default,,0,0,0,,갈드컵 여는 거?
Dialogue: 0,0:00:14.81,0:00:15.50,Default,,0,0,0,,나 그거는 모르는데?
Dialogue: 0,0:00:15.56,0:00:16.96,Default,,0,0,0,,선생님을 구합니다 해야 된다고?
Dialogue: 0,0:00:17.01,0:00:17.92,Default,,0,0,0,,근데 나는
Dialogue: 0,0:00:17.98,0:00:19.21,Default,,0,0,0,,배우고 싶은 거 있어요
Dialogue: 0,0:00:19.26,0:00:20.16,Default,,0,0,0,,진짜 진지하게 선생님
Dialogue: 0,0:00:20.21,0:00:21.12,Default,,0,0,0,,구하고 싶은 거 있어
Dialogue: 0,0:00:21.17,0:00:22.32,Default,,0,0,0,,수학생들
Dialogue: 0,0:00:22.37,0:00:26.29,Default,,0,0,0,,내가 하나를 이제 이렇게
Dialogue: 0,0:00:26.50,0:00:28.10,Default,,0,0,0,,이렇게 원한다면 나는
Dialogue: 0,0:00:28.15,0:00:29.00,Default,,0,0,0,,수학선생님을
Dialogue: 0,0:00:29.05,0:00:29.70,Default,,0,0,0,,뇨룡이한테 수학
Dialogue: 0,0:00:29.75,0:00:30.64,Default,,0,0,0,,가르쳐달라고 하라고?
Dialogue: 0,0:00:30.69,0:00:31.24,Default,,0,0,0,,해볼까?
Dialogue: 0,0:00:31.29,0:00:32.10,Default,,0,0,0,,뇨룡이는 문과
Dialogue: 0,0:00:32.15,0:00:33.78,Default,,0,0,0,,아니 그게 뇨룡이 문과잖아
Dialogue: 0,0:00:33.83,0:00:34.59,Default,,0,0,0,,그러니까 수학
Dialogue: 0,0:00:35.07,0:00:36.32,Default,,0,0,0,,나 수학 배우고 싶은데
Dialogue: 0,0:00:36.37,0:00:37.46,Default,,0,0,0,,수학을 배울 수가 없어
Dialogue: 0,0:00:38.02,0:00:38.98,Default,,0,0,0,,너 가르치려면 EBS
Dialogue: 0,0:00:39.03,0:00:40.23,Default,,0,0,0,,특집 만들어야 함
Dialogue: 0,0:00:40.28,0:00:41.04,Default,,0,0,0,,어? 넥클릿한테
Dialogue: 0,0:00:41.09,0:00:42.07,Default,,0,0,0,,알려달라고 하자고?
Dialogue: 0,0:00:42.11,0:00:42.71,Default,,0,0,0,,넥클릿?
Dialogue: 0,0:00:42.75,0:00:43.92,Default,,0,0,0,,넥클릿도 문과라고?
Dialogue: 0,0:00:43.97,0:00:45.10,Default,,0,0,0,,넥 넥
Dialogue: 0,0:00:45.15,0:00:46.10,Default,,0,0,0,,넥클릿 넥클릿
Dialogue: 0,0:00:46.15,0:00:47.85,Default,,0,0,0,,너무 오래돼서 모르시지 않을까?
Dialogue: 0,0:00:47.89,0:00:49.10,Default,,0,0,0,,가르치기 힘들지 않을까?
Dialogue: 0,0:00:49.15,0:00:50.57,Default,,0,0,0,,물론 나보단 똑같
Dialogue: 0,0:00:50.61,0:00:51.70,Default,,0,0,0,,당연히 나보단 백배
Dialogue: 0,0:00:51.75,0:00:52.60,Default,,0,0,0,,천배 똑똑하시죠
Dialogue: 0,0:00:52.65,0:00:53.45,Default,,0,0,0,,근데 클리님이랑
Dialogue: 0,0:00:53.50,0:00:55.19,Default,,0,0,0,,누룽이가 나는 그냥 거의 지하
Dialogue: 0,0:00:55.39,0:00:56.71,Default,,0,0,0,,지하 바닥이고
Dialogue: 0,0:00:56.75,0:00:58.72,Default,,0,0,0,,거기는 완전 천상이고
Dialogue: 0,0:00:58.77,0:01:00.00,Default,,0,0,0,,천상이고 근데
Dialogue: 0,0:01:00.05,0:01:01.64,Default,,0,0,0,,일본의 버투버 미적분
Dialogue: 0,0:01:01.69,0:01:03.13,Default,,0,0,0,,이해시키기 있던 데
Dialogue: 0,0:01:03.17,0:01:04.21,Default,,0,0,0,,아니 그니까 나도
Dialogue: 0,0:01:04.26,0:01:05.65,Default,,0,0,0,,미적분 이해시키기 그거
Dialogue: 0,0:01:05.70,0:01:06.37,Default,,0,0,0,,하고 싶은데
Dialogue: 0,0:01:06.42,0:01:07.76,Default,,0,0,0,,선생님을 못 구했어
Dialogue: 0,0:01:08.07,0:01:09.07,Default,,0,0,0,,아 나도 그거 하고 싶거든?
Dialogue: 0,0:01:09.12,0:01:11.01,Default,,0,0,0,,미적분 이해시키기 하고 싶은데
Dialogue: 0,0:01:11.06,0:01:12.96,Default,,0,0,0,,선생님을 못 구해가지고
Dialogue: 0,0:01:13.01,0:01:14.32,Default,,0,0,0,,연대 고대 누가 더 잘
Dialogue: 0,0:01:14.37,0:01:15.35,Default,,0,0,0,,그랬지 말아구요?
Dialogue: 0,0:01:15.82,0:01:18.31,Default,,0,0,0,,뭐 연대 고대 그걸 왜 해 내가
Dialogue: 0,0:01:18.35,0:01:19.36,Default,,0,0,0,,내가 무슨 자격이
Dialogue: 0,0:01:19.41,0:01:20.76,Default,,0,0,0,,있다고 연대 고대를 해
Dialogue: 0,0:01:20.81,0:01:22.87,Default,,0,0,0,,미친 거 아니야
Dialogue: 0,0:01:22.92,0:01:24.09,Default,,0,0,0,,리사님 분수 나누기
Dialogue: 0,0:01:24.29,0:01:25.39,Default,,0,0,0,,못하게 할 줄 아시나요?
Dialogue: 0,0:01:25.43,0:01:25.83,Default,,0,0,0,,아니요?
Dialogue: 0,0:01:25.88,0:01:26.77,Default,,0,0,0,,아니요 나 미적분
Dialogue: 0,0:01:26.82,0:01:27.83,Default,,0,0,0,,배우기 하고 싶은데
Dialogue: 0,0:01:27.88,0:01:28.82,Default,,0,0,0,,하나 물어볼까?
Dialogue: 0,0:01:28.87,0:01:30.16,Default,,0,0,0,,근데 나를 진짜
Dialogue: 0,0:01:30.21,0:01:31.67,Default,,0,0,0,,질려하면 어떡해?
Dialogue: 0,0:01:31.71,0:01:34.87,Default,,0,0,0,,약간 PTSD 있어가지고
Dialogue: 0,0:01:34.92,0:01:36.12,Default,,0,0,0,,영어 선생님인 이모도
Dialogue: 0,0:01:36.17,0:01:37.26,Default,,0,0,0,,저를 영어 가르치다
Dialogue: 0,0:01:37.31,0:01:37.82,Default,,0,0,0,,포기했고요
Dialogue: 0,0:01:37.87,0:01:38.89,Default,,0,0,0,,지금 학교 선생님 하고
Dialogue: 0,0:01:38.94,0:01:40.04,Default,,0,0,0,,있는 친구도 저를 수학을
Dialogue: 0,0:01:40.09,0:01:41.10,Default,,0,0,0,,가르치다 포기했거든요?
Dialogue: 0,0:01:41.15,0:01:42.32,Default,,0,0,0,,저에게 늘 약간
Dialogue: 0,0:01:42.37,0:01:44.31,Default,,0,0,0,,질린다는 표정을 지으면서
Dialogue: 0,0:01:44.35,0:01:45.67,Default,,0,0,0,,이렇게 하면서 저를
Dialogue: 0,0:01:45.72,0:01:46.63,Default,,0,0,0,,했단 말이에요
Dialogue: 0,0:01:46.97,0:01:47.80,Default,,0,0,0,,나 그래서 그게 약간
Dialogue: 0,0:01:47.85,0:01:48.87,Default,,0,0,0,,PTSD가 와가지고
Dialogue: 0,0:01:49.13,0:01:49.95,Default,,0,0,0,,정 떨어졌나 봐 뭘 정
Dialogue: 0,0:01:50.00,0:01:50.55,Default,,0,0,0,,떨어졌나 봐
Dialogue: 0,0:01:51.47,0:01:52.56,Default,,0,0,0,,왜 자꾸 떨어져!
Dialogue: 0,0:01:52.61,0:01:54.67,Default,,0,0,0,,미사야 미적분 편황이냐?
Dialogue: 0,0:01:54.71,0:01:55.65,Default,,0,0,0,,만약 한다면
Dialogue: 0,0:01:55.70,0:01:56.92,Default,,0,0,0,,미적분 편황이냐고?
Dialogue: 0,0:01:56.97,0:01:58.01,Default,,0,0,0,,요롱이 한다면 물어볼까?
Dialogue: 0,0:01:58.06,0:01:58.59,Default,,0,0,0,,요롱이?
Dialogue: 0,0:01:58.64,0:01:59.46,Default,,0,0,0,,요롱이?
Dialogue: 0,0:01:59.81,0:02:00.07,Default,,0,0,0,,내 클린?
Dialogue: 0,0:02:00.12,0:02:01.10,Default,,0,0,0,,시타가면 어떡해?
Dialogue: 0,0:02:01.92,0:02:02.25,Default,,0,0,0,,둘 다 연고전!
Dialogue: 0,0:02:02.65,0:02:03.67,Default,,0,0,0,,왜 자꾸 연고전을 시켜!
Dialogue: 0,0:02:03.71,0:02:05.22,Default,,0,0,0,,아! 왜 이러는 거야
Dialogue: 0,0:02:05.69,0:02:06.07,Default,,0,0,0,,이 사람들!
Dialogue: 0,0:02:06.56,0:02:08.28,Default,,0,0,0,,왜 자꾸 싸움을 붙이고 싶어해!
Dialogue: 0,0:02:08.34,0:02:09.61,Default,,0,0,0,,무슨 연고전이네
Dialogue: 0,0:02:09.66,0:02:10.60,Default,,0,0,0,,고연전이네!
Dialogue: 0,0:02:11.14,0:02:12.53,Default,,0,0,0,,왜 이러는 거야 진짜
Dialogue: 0,0:02:12.58,0:02:13.92,Default,,0,0,0,,미치겠네 진짜!
Dialogue: 0,0:02:14.55,0:02:15.06,Default,,0,0,0,,뭘 사회해서
Dialogue: 0,0:02:15.12,0:02:15.70,Default,,0,0,0,,그럴까?
Dialogue: 0,0:02:16.03,0:02:16.79,Default,,0,0,0,,뭐 한번 둘 다
Dialogue: 0,0:02:16.84,0:02:17.46,Default,,0,0,0,,물어볼까?
Dialogue: 0,0:02:17.51,0:02:19.19,Default,,0,0,0,,미적분 가르치기
Dialogue: 0,0:02:19.40,0:02:20.28,Default,,0,0,0,,내가 뭐라고
Dialogue: 0,0:02:20.34,0:02:21.71,Default,,0,0,0,,근데 미적분 할 줄 아나?
Dialogue: 0,0:02:21.76,0:02:22.62,Default,,0,0,0,,유롱이한테 미적분 할
Dialogue: 0,0:02:22.98,0:02:23.55,Default,,0,0,0,,줄 아냐고 물어볼까?
Dialogue: 0,0:02:23.60,0:02:24.52,Default,,0,0,0,,유롱아 너 미적분 할
Dialogue: 0,0:02:24.86,0:02:25.40,Default,,0,0,0,,줄 알아? 이렇게?
Dialogue: 0,0:02:25.85,0:02:26.59,Default,,0,0,0,,아 그래요? 알아요?
Dialogue: 0,0:02:26.64,0:02:28.38,Default,,0,0,0,,너의 처음 듣는 표정도 있고?
Dialogue: 0,0:02:28.43,0:02:29.70,Default,,0,0,0,,넥클릭과 유롱이 님은
Dialogue: 0,0:02:29.75,0:02:31.25,Default,,0,0,0,,세대 차이가 많이 나는데
Dialogue: 0,0:02:31.30,0:02:32.72,Default,,0,0,0,,연고전 할 거면 젬마
Dialogue: 0,0:02:32.77,0:02:33.78,Default,,0,0,0,,넥클릭은 어떠?
Dialogue: 0,0:02:33.84,0:02:35.81,Default,,0,0,0,,근데 그 젬마 넥클릭은
Dialogue: 0,0:02:35.86,0:02:37.17,Default,,0,0,0,,연고전이 아니라
Dialogue: 0,0:02:37.22,0:02:40.06,Default,,0,0,0,,너무 좀 대단한 플랫폼
Dialogue: 0,0:02:40.12,0:02:41.83,Default,,0,0,0,,플랫폼 아니죠? MCN
Dialogue: 0,0:02:41.88,0:02:44.05,Default,,0,0,0,,대단한 회사의 주문이지 않나
Dialogue: 0,0:02:44.10,0:02:45.50,Default,,0,0,0,,그래서 좀 좀
Dialogue: 0,0:02:45.69,0:02:48.02,Default,,0,0,0,,에이 둘 다 그래 바빠요
Dialogue: 0,0:02:48.07,0:02:49.60,Default,,0,0,0,,저랑 이렇게 놀아주실
Dialogue: 0,0:02:49.65,0:02:50.60,Default,,0,0,0,,시간이 없어요
Dialogue: 0,0:02:50.65,0:02:52.40,Default,,0,0,0,,이기는 사람이 아리사 가져가
Dialogue: 0,0:02:52.46,0:02:54.38,Default,,0,0,0,,기적뿐 가르쳐달라고 해볼까?
Dialogue: 0,0:02:54.43,0:02:55.81,Default,,0,0,0,,아니 인텐트가 날 왜
Dialogue: 0,0:02:55.86,0:02:57.88,Default,,0,0,0,,가지고 싶어해 미친 거 아니야
Dialogue: 0,0:02:57.93,0:02:59.22,Default,,0,0,0,,그리고 뭘 가져가게야
Dialogue: 0,0:02:59.61,0:03:00.56,Default,,0,0,0,,나 하루에 있을 거야
Dialogue: 0,0:03:00.62,0:03:02.27,Default,,0,0,0,,그리고 인텐트도 나를
Dialogue: 0,0:03:02.32,0:03:04.12,Default,,0,0,0,,별로 안 가지고 싶어해
Dialogue: 0,0:03:05.11,0:03:05.98,Default,,0,0,0,,안 된다고
Dialogue: 0,0:03:06.59,0:03:07.65,Default,,0,0,0,,이 아리사를 이해시키면
Dialogue: 0,0:03:07.70,0:03:09.58,Default,,0,0,0,,아리사에 계약권을 드립니다
Dialogue: 0,0:03:09.63,0:03:10.27,Default,,0,0,0,,응답이 뭐 하시죠? 
Dialogue: 0,0:03:10.32,0:03:10.88,Default,,0,0,0,,응답이 뭐 하시죠?
Dialogue: 0,0:03:11.45,0:03:13.00,Default,,0,0,0,,저 제가 뭐라고 그냥
Dialogue: 0,0:03:13.19,0:03:14.16,Default,,0,0,0,,이러는 겁니다
Dialogue: 0,0:03:14.21,0:03:17.46,Default,,0,0,0,,시장평가 받아보라고요?
Dialogue: 0,0:03:17.78,0:03:18.54,Default,,0,0,0,,아 지금 뭐라는 거야
Dialogue: 0,0:03:18.59,0:03:19.54,Default,,0,0,0,,카론에 평소에 뼈를
Dialogue: 0,0:03:19.59,0:03:20.14,Default,,0,0,0,,묻을 거예요
Dialogue: 0,0:03:20.19,0:03:21.89,Default,,0,0,0,,그리고 민첸트 분들의
Dialogue: 0,0:03:21.94,0:03:23.94,Default,,0,0,0,,그런 사랑이 있는데 왜?
Dialogue: 0,0:03:24.36,0:03:25.04,Default,,0,0,0,,왜 자꾸 나를
Dialogue: 0,0:03:26.25,0:03:26.48,Default,,0,0,0,,야 씨 나 뭔 소리야
Dialogue: 0,0:03:26.93,0:03:27.26,Default,,0,0,0,,좀 가라고요?
Dialogue: 0,0:03:27.31,0:03:28.56,Default,,0,0,0,,카론이 뼈 묻게 해준대?
Dialogue: 0,0:03:28.62,0:03:30.30,Default,,0,0,0,,아니 왜냐면 그런 거로
Dialogue: 0,0:03:30.35,0:03:31.88,Default,,0,0,0,,장난치는 거 아니에요
Dialogue: 0,0:03:31.93,0:03:32.96,Default,,0,0,0,,버츠버 FA가
Dialogue: 0,0:03:33.01,0:03:34.04,Default,,0,0,0,,궁금하다고요?
Dialogue: 0,0:03:34.09,0:03:36.16,Default,,0,0,0,,버츠버 FA가 어딨어
Dialogue: 0,0:03:36.21,0:03:37.03,Default,,0,0,0,,그런 게 도대체
Dialogue: 0,0:03:37.08,0:03:37.56,Default,,0,0,0,,어딨는데?
Dialogue: 0,0:03:38.19,0:03:39.28,Default,,0,0,0,,뭐 리적 시장이에요
Dialogue: 0,0:03:39.34,0:03:40.29,Default,,0,0,0,,너가 최초를 해보자고?
Dialogue: 0,0:03:40.52,0:03:41.40,Default,,0,0,0,,아니 그럼 누가 날
Dialogue: 0,0:03:41.45,0:03:42.33,Default,,0,0,0,,데려가고 싶었는데?
Dialogue: 0,0:03:42.38,0:03:44.11,Default,,0,0,0,,누가 아리사를 데려가고
Dialogue: 0,0:03:44.16,0:03:44.85,Default,,0,0,0,,싶었는데?
Dialogue: 0,0:03:44.90,0:03:46.15,Default,,0,0,0,,저요!
Dialogue: 0,0:03:47.17,0:03:48.09,Default,,0,0,0,,아~ 무효이가?
Dialogue: 0,0:03:48.14,0:03:49.07,Default,,0,0,0,,무효아 그거 알아?
Dialogue: 0,0:03:49.12,0:03:50.17,Default,,0,0,0,,생각보다 리사를 많이
Dialogue: 0,0:03:50.52,0:03:51.37,Default,,0,0,0,,안 가지고 싶어 할걸?
Dialogue: 0,0:03:51.42,0:03:52.97,Default,,0,0,0,,사람들이
Dialogue: 0,0:03:53.02,0:03:56.93,Default,,0,0,0,,리사는 여기가 참 좋아
Dialogue: 0,0:03:56.98,0:03:59.69,Default,,0,0,0,,리사야 수수료 5%만
Dialogue: 0,0:03:59.74,0:04:01.43,Default,,0,0,0,,어딘데? 거기 어딘데요?
Dialogue: 0,0:04:01.48,0:04:02.85,Default,,0,0,0,,수수료 5%에 어딘데요?
Dialogue: 0,0:04:02.90,0:04:04.73,Default,,0,0,0,,갈게요 어딘데요?
Dialogue: 0,0:04:04.78,0:04:05.65,Default,,0,0,0,,농담인 거 아시죠?
Dialogue: 0,0:04:06.70,0:04:07.69,Default,,0,0,0,,다 농담입니다
Dialogue: 0,0:04:08.51,0:04:09.68,Default,,0,0,0,,뭘 큰일 났어요~
Dialogue: 0,0:04:10.17,0:04:11.43,Default,,0,0,0,,난 치즈게 계속 붙어
Dialogue: 0,0:04:11.48,0:04:12.38,Default,,0,0,0,,있을 거야~
Dialogue: 0,0:04:13.18,0:04:13.88,Default,,0,0,0,,뭔 소리야~
Dialogue: 0,0:04:13.93,0:04:15.43,Default,,0,0,0,,치즈게 뼈를 묻을
Dialogue: 0,0:04:15.48,0:04:16.29,Default,,0,0,0,,거라고요~
Dialogue: 0,0:04:16.34,0:04:18.20,Default,,0,0,0,,대표님 보고 계시죠?
Dialogue: 0,0:04:18.25,0:04:20.38,Default,,0,0,0,,대표님이라도 밥 먹기로
Dialogue: 0,0:04:20.43,0:04:21.29,Default,,0,0,0,,했잖아요~
Dialogue: 0,0:04:21.34,0:04:22.83,Default,,0,0,0,,저희 또 곧 봤으면
Dialogue: 0,0:04:22.88,0:04:23.61,Default,,0,0,0,,좋겠어요~
Dialogue: 0,0:04:23.88,0:04:24.50,Default,,0,0,0,,뭘 정상 비율 좀
Dialogue: 0,0:04:24.56,0:04:25.11,Default,,0,0,0,,올려주세요~
Dialogue: 0,0:04:25.16,0:04:26.00,Default,,0,0,0,,아~
Dialogue: 0,0:04:26.27,0:04:26.85,Default,,0,0,0,,이 사람들 왜 이
Dialogue: 0,0:04:26.90,0:04:27.79,Default,,0,0,0,,사람들 이런 거 왜
Dialogue: 0,0:04:27.84,0:04:28.55,Default,,0,0,0,,캐저에 무슨 뭐
Dialogue: 0,0:04:28.60,0:04:31.14,Default,,0,0,0,,FA니 무슨 연고전이니 어?
Dialogue: 0,0:04:31.19,0:04:33.00,Default,,0,0,0,,고연전이니 이상한 그냥 도박
Dialogue: 0,0:04:33.26,0:04:34.39,Default,,0,0,0,,도파민의 내가 지금
Dialogue: 0,0:04:34.44,0:04:35.70,Default,,0,0,0,,아주 그냥 이런 것만
Dialogue: 0,0:04:35.75,0:04:37.37,Default,,0,0,0,,좋아하는 사람들 아주 그냥
Dialogue: 0,0:04:37.42,0:04:38.28,Default,,0,0,0,,갈라 갈라 쇼만
Dialogue: 0,0:04:38.33,0:04:39.53,Default,,0,0,0,,좋아하는 사람들 아주
Dialogue: 0,0:04:39.96,0:04:40.67,Default,,0,0,0,,그냥 미치겠어 그냥
Dialogue: 0,0:04:40.72,0:04:43.25,Default,,0,0,0,,진짜 싫다  진짜 싫다
Dialogue: 0,0:04:43.30,0:04:46.17,Default,,0,0,0,,생방 플랫폼 정도도 세우고
Dialogue: 0,0:04:46.22,0:04:47.65,Default,,0,0,0,,뭐라는 거야!
Dialogue: 0,0:04:47.70,0:04:49.19,Default,,0,0,0,,생방 플랫폼이 내가
Dialogue: 0,0:04:49.25,0:04:50.75,Default,,0,0,0,,어떻게 세우냐고요!
Dialogue: 0,0:04:50.80,0:04:52.55,Default,,0,0,0,,여러분 최고의 플랫폼!
Dialogue: 0,0:04:52.60,0:04:53.61,Default,,0,0,0,,이렇게 말하면 안 되나?
Dialogue: 0,0:04:53.66,0:04:54.85,Default,,0,0,0,,쓰읍
Dialogue: 0,0:04:54.90,0:04:55.92,Default,,0,0,0,,헤이 don't
Dialogue: 0,0:04:55.97,0:04:57.27,Default,,0,0,0,,even worry
Dialogue: 0,0:04:57.32,0:04:58.49,Default,,0,0,0,,about it 
Dialogue: 0,0:04:58.54,0:05:00.11,Default,,0,0,0,,안녕하세요 반갑습니다!
Dialogue: 0,0:05:00.16,0:05:01.20,Default,,0,0,0,,초심 발언 잘 들었으니?
Dialogue: 0,0:05:01.79,0:05:02.94,Default,,0,0,0,,네 뭐예요? 저는 아무
Dialogue: 0,0:05:02.99,0:05:04.00,Default,,0,0,0,,말도 안 했는데
Dialogue: 0,0:05:04.74,0:05:05.71,Default,,0,0,0,,아 왜 저래 진짜 이런
Dialogue: 0,0:05:06.42,0:05:06.70,Default,,0,0,0,,걸 왜 만들어
Dialogue: 0,0:05:06.75,0:05:08.75,Default,,0,0,0,,진짜 좀 그만
Dialogue: 0,0:05:08.80,0:05:09.91,Default,,0,0,0,,진짜 싫어
Dialogue: 0,0:05:10.57,0:05:12.35,Default,,0,0,0,,아 진짜 싫다 그냥
Dialogue: 0,0:05:12.40,0:05:13.37,Default,,0,0,0,,내가 뭐라고 나는
Dialogue: 0,0:05:13.42,0:05:14.63,Default,,0,0,0,,고졸인데 무슨 연세대
Dialogue: 0,0:05:14.68,0:05:16.35,Default,,0,0,0,,고려대 나온 대단하는 사람들
Dialogue: 0,0:05:16.40,0:05:18.35,Default,,0,0,0,,내가 뭐라고 갈라갈라 쇼를 해
Dialogue: 0,0:05:18.40,0:05:19.85,Default,,0,0,0,,이게 옳은 세상이냐?
Dialogue: 0,0:05:20.35,0:05:21.64,Default,,0,0,0,,난 대학교도 안 나왔어
Dialogue: 0,0:05:21.69,0:05:23.05,Default,,0,0,0,,이게 맞냐고요
Dialogue: 0,0:05:23.10,0:05:24.31,Default,,0,0,0,,고졸이니까 할 수 있는
Dialogue: 0,0:05:24.36,0:05:25.05,Default,,0,0,0,,콘텐츠라고요?
Dialogue: 0,0:05:25.10,0:05:26.44,Default,,0,0,0,,진짜 무식하다
Dialogue: 0,0:05:26.85,0:05:27.90,Default,,0,0,0,,아 무식한 내가 싫다
Dialogue: 0,0:05:28.10,0:05:30.02,Default,,0,0,0,,고향 없는 콘텐츠를
Dialogue: 0,0:05:30.07,0:05:32.58,Default,,0,0,0,,생각하는 내가 싫다 그냥
Dialogue: 0,0:05:32.63,0:05:35.37,Default,,0,0,0,,원초적인 맛이 더 싫어
Dialogue: 0,0:05:35.81,0:05:36.95,Default,,0,0,0,,아 근데 미작품 배역이
Dialogue: 0,0:05:37.00,0:05:38.41,Default,,0,0,0,,만약에 요령이 된다고
Dialogue: 0,0:05:38.46,0:05:39.46,Default,,0,0,0,,하면 물어볼게요
Dialogue: 0,0:05:39.51,0:05:41.17,Default,,0,0,0,,넥클리다면 물어보긴 할게요
Dialogue: 0,0:05:41.22,0:05:42.38,Default,,0,0,0,,근데 그 재밌을진 모르겠다
Dialogue: 0,0:05:42.43,0:05:43.28,Default,,0,0,0,,근데 만약에 진짜 리얼
Dialogue: 0,0:05:43.33,0:05:44.26,Default,,0,0,0,,UFC 되면 어떻게 내가
Dialogue: 0,0:05:44.31,0:05:45.31,Default,,0,0,0,,자꾸 이해를 하나도 못해서
Dialogue: 0,0:05:45.36,0:05:47.78,Default,,0,0,0,,근데 이게 뭐예요 하다가 막
Dialogue: 0,0:05:47.83,0:05:49.22,Default,,0,0,0,,이사님 그냥 그만하시죠
Dialogue: 0,0:05:49.27,0:05:51.16,Default,,0,0,0,,이렇게 하면 어떡해?
Dialogue: 0,0:05:54.05,0:05:55.42,Default,,0,0,0,,리사야 최종학부 미적분
Dialogue: 0,0:05:55.47,0:05:57.44,Default,,0,0,0,,수능 30분 문제 풀기로 가보자
Dialogue: 0,0:05:57.49,0:05:59.14,Default,,0,0,0,,미적분 수능 30분 문제요?
Dialogue: 0,0:05:59.75,0:06:01.36,Default,,0,0,0,,그 나이에  근데 리사야
Dialogue: 0,0:06:02.18,0:06:02.90,Default,,0,0,0,,네  너 고등학교 거의
Dialogue: 0,0:06:02.95,0:06:04.44,Default,,0,0,0,,출석 안 한 거 아니냐
Dialogue: 0,0:06:04.49,0:06:05.74,Default,,0,0,0,,네? 아닌데요
Dialogue: 0,0:06:06.82,0:06:07.28,Default,,0,0,0,,저 저 출석했는데요?
Dialogue: 0,0:06:07.33,0:06:08.67,Default,,0,0,0,,수능 끝나고 나서부터
Dialogue: 0,0:06:09.36,0:06:09.94,Default,,0,0,0,,잘 안 갔을 뿐이지
Dialogue: 0,0:06:09.99,0:06:11.02,Default,,0,0,0,,갔어요
Dialogue: 0,0:06:11.07,0:06:12.70,Default,,0,0,0,,나도 초진이랑 지식대표
Dialogue: 0,0:06:12.75,0:06:14.10,Default,,0,0,0,,뜨려고 생각했거든?
Dialogue: 0,0:06:14.15,0:06:15.51,Default,,0,0,0,,내가 주변 초등학생 좀
Dialogue: 0,0:06:15.56,0:06:16.56,Default,,0,0,0,,탐색을 했거든요?
Dialogue: 0,0:06:16.61,0:06:17.82,Default,,0,0,0,,없어 초등학생이 없어
Dialogue: 0,0:06:18.24,0:06:19.64,Default,,0,0,0,,내 사출도 초등학생이 없고 없어
Dialogue: 0,0:06:19.69,0:06:20.79,Default,,0,0,0,,그래도 초유근대야 나랑
Dialogue: 0,0:06:20.84,0:06:22.22,Default,,0,0,0,,지식 수준이 많을 거 아니야
Dialogue: 0,0:06:22.27,0:06:23.50,Default,,0,0,0,,나도 초등학교 가는 좋고
Dialogue: 0,0:06:24.25,0:06:25.67,Default,,0,0,0,,그 뭐야 사촌동생은 있어
Dialogue: 0,0:06:25.72,0:06:27.00,Default,,0,0,0,,초1은 있어 초1
Dialogue: 0,0:06:27.06,0:06:28.19,Default,,0,0,0,,초1은 내가 이길 거
Dialogue: 0,0:06:28.24,0:06:29.91,Default,,0,0,0,,아니야 걔는 말도 잘 못하는데
Dialogue: 0,0:06:30.54,0:06:31.65,Default,,0,0,0,,뭐 초1 고고예요
Dialogue: 0,0:06:32.37,0:06:33.67,Default,,0,0,0,,뭔 초1 고고야
Dialogue: 0,0:06:33.72,0:06:35.17,Default,,0,0,0,,초1을 못 이기면 그건
Dialogue: 0,0:06:35.22,0:06:36.17,Default,,0,0,0,,사람이 아니잖아
Dialogue: 0,0:06:36.22,0:06:37.11,Default,,0,0,0,,무효아 무효아
Dialogue: 0,0:06:37.16,0:06:38.11,Default,,0,0,0,,무효 이과야?
Dialogue: 0,0:06:38.16,0:06:39.71,Default,,0,0,0,,님들 문과요 이과예요?
Dialogue: 0,0:06:39.76,0:06:40.76,Default,,0,0,0,,통신 전공하고
Dialogue: 0,0:06:40.81,0:06:42.11,Default,,0,0,0,,삼전에서라고 있어
Dialogue: 0,0:06:42.16,0:06:43.44,Default,,0,0,0,,뭐야 왜 갑자기 자기
Dialogue: 0,0:06:43.49,0:06:44.17,Default,,0,0,0,,직업을 까요
Dialogue: 0,0:06:44.22,0:06:45.75,Default,,0,0,0,,백수들 기중이네 나가나가
Dialogue: 0,0:06:45.80,0:06:46.84,Default,,0,0,0,,그러니까 백수들
Dialogue: 0,0:06:46.89,0:06:47.94,Default,,0,0,0,,기중이면 어떡해
Dialogue: 0,0:06:48.00,0:06:49.50,Default,,0,0,0,,나도 삼전대주지
Dialogue: 0,0:06:49.56,0:06:50.71,Default,,0,0,0,,나는 내 전 재산이
Dialogue: 0,0:06:50.76,0:06:52.05,Default,,0,0,0,,네이버에 들어가 있어
Dialogue: 0,0:06:52.10,0:06:52.93,Default,,0,0,0,,왜요?
Dialogue: 0,0:06:54.29,0:06:56.44,Default,,0,0,0,,언젠간 네이버가 오를 것이에요
Dialogue: 0,0:06:56.49,0:06:58.96,Default,,0,0,0,,제산만에 졸업겠네 라녀
Dialogue: 0,0:06:59.01,0:07:00.54,Default,,0,0,0,,빨려  수학과 나왔어요
Dialogue: 0,0:07:00.91,0:07:01.50,Default,,0,0,0,,어  이거 전공
Dialogue: 0,0:07:01.55,0:07:03.18,Default,,0,0,0,,살리려면 진짜 뇌가 달라요
Dialogue: 0,0:07:03.23,0:07:04.82,Default,,0,0,0,,수학과 나왔다고 뭐 와?
Dialogue: 0,0:07:05.23,0:07:05.90,Default,,0,0,0,,야 수학과들은 진짜
Dialogue: 0,0:07:05.95,0:07:07.30,Default,,0,0,0,,수학을 사랑하는 사람들만
Dialogue: 0,0:07:07.35,0:07:08.38,Default,,0,0,0,,나오는 거 아니야?
Dialogue: 0,0:07:08.85,0:07:09.23,Default,,0,0,0,,그 막 수학으로 배틀
Dialogue: 0,0:07:09.28,0:07:10.07,Default,,0,0,0,,뜨는 사람들이 수학과
Dialogue: 0,0:07:10.12,0:07:10.76,Default,,0,0,0,,그런 거 아니야?
Dialogue: 0,0:07:10.81,0:07:11.67,Default,,0,0,0,,한타지 수학
Dialogue: 0,0:07:11.72,0:07:12.72,Default,,0,0,0,,배선이라고요?
Dialogue: 0,0:07:12.77,0:07:13.61,Default,,0,0,0,,아니 그런 거 하는 거
Dialogue: 0,0:07:13.66,0:07:14.58,Default,,0,0,0,,아니야? 나 약간 그렇게
Dialogue: 0,0:07:14.63,0:07:15.02,Default,,0,0,0,,생각했는데?
Dialogue: 0,0:07:15.07,0:07:16.23,Default,,0,0,0,,아니 왜냐면 내가 유
Dialogue: 0,0:07:16.28,0:07:17.76,Default,,0,0,0,,퀴즈인가? 유 퀴즈를 봤어
Dialogue: 0,0:07:18.10,0:07:18.93,Default,,0,0,0,,뭐 수학 3개 상이
Dialogue: 0,0:07:18.98,0:07:19.86,Default,,0,0,0,,있대요 님들아?
Dialogue: 0,0:07:19.91,0:07:20.39,Default,,0,0,0,,근데 그 수학
Dialogue: 0,0:07:20.78,0:07:22.17,Default,,0,0,0,,뭐냐면 수학의 문제
Dialogue: 0,0:07:22.22,0:07:24.61,Default,,0,0,0,,아무 못 푸는 문제를 계속 푼대
Dialogue: 0,0:07:24.66,0:07:25.51,Default,,0,0,0,,근데 그걸 왜 풀어?
Dialogue: 0,0:07:25.56,0:07:26.56,Default,,0,0,0,,그러니까 나 같은 이런
Dialogue: 0,0:07:26.61,0:07:27.43,Default,,0,0,0,,범부에 내려오는 게
Dialogue: 0,0:07:27.48,0:07:28.39,Default,,0,0,0,,이해할 수 없는 거야
Dialogue: 0,0:07:28.44,0:07:29.73,Default,,0,0,0,,그걸 왜 푸는 거야?
Dialogue: 0,0:07:29.78,0:07:30.56,Default,,0,0,0,,어? 그게 인류 발전에
Dialogue: 0,0:07:30.61,0:07:31.73,Default,,0,0,0,,기여하는 거예요?  이런 거 다
Dialogue: 0,0:07:31.78,0:07:32.49,Default,,0,0,0,,어?
Dialogue: 0,0:07:32.54,0:07:34.45,Default,,0,0,0,,그래서 수학과를 가는
Dialogue: 0,0:07:34.50,0:07:35.87,Default,,0,0,0,,사람들은 변태다
Dialogue: 0,0:07:35.92,0:07:37.03,Default,,0,0,0,,이런 생각이 있어
Dialogue: 0,0:07:37.08,0:07:38.11,Default,,0,0,0,,수학 변태
Dialogue: 0,0:07:38.16,0:07:39.67,Default,,0,0,0,,그럼 편황하는 사람은
Dialogue: 0,0:07:39.72,0:07:40.51,Default,,0,0,0,,미련한 사람
Dialogue: 0,0:07:40.56,0:07:42.29,Default,,0,0,0,,진짜 무례한 소리라고요?
Dialogue: 0,0:07:42.34,0:07:43.13,Default,,0,0,0,,죄송해요
Dialogue: 0,0:07:43.45,0:07:44.18,Default,,0,0,0,,저 그게 좋은 뜻으로
Dialogue: 0,0:07:44.23,0:07:44.75,Default,,0,0,0,,말한 겁니다
Dialogue: 0,0:07:44.80,0:07:45.69,Default,,0,0,0,,제가 못 배워서
Dialogue: 0,0:07:45.92,0:07:47.43,Default,,0,0,0,,단어 선택이 안 좋아서
Dialogue: 0,0:07:47.48,0:07:48.08,Default,,0,0,0,,죄송합니다
Dialogue: 0,0:07:48.13,0:07:49.12,Default,,0,0,0,,아니 근데 변태라는 말
Dialogue: 0,0:07:49.18,0:07:49.91,Default,,0,0,0,,좋은 거 아니야?
Dialogue: 0,0:07:49.96,0:07:51.05,Default,,0,0,0,,부모님한테 변태라고 할
Dialogue: 0,0:07:51.44,0:07:51.73,Default,,0,0,0,,수 있냐고요?
Dialogue: 0,0:07:51.78,0:07:52.68,Default,,0,0,0,,네?
Dialogue: 0,0:07:52.74,0:07:54.18,Default,,0,0,0,,무슨 말씀이에요 갑자기
Dialogue: 0,0:07:54.24,0:08:00.68,Default,,0,0,0,,안녕하세요
Dialogue: 0,0:08:00.74,0:08:02.17,Default,,0,0,0,,여러분 반갑습니다
Dialogue: 0,0:08:02.22,0:08:03.68,Default,,0,0,0,,저는 모든 사람이
Dialogue: 0,0:08:03.73,0:08:05.37,Default,,0,0,0,,최고라고 생각합니다
Dialogue: 0,0:08:05.42,0:08:06.49,Default,,0,0,0,,인간 찬가
Dialogue: 0,0:08:06.54,0:08:07.81,Default,,0,0,0,,인간은 대단하다
Dialogue: 0,0:08:07.86,0:08:09.55,Default,,0,0,0,,지식을 탐구하는 자들
Dialogue: 0,0:08:09.60,0:08:10.82,Default,,0,0,0,,앞으로 발전하리
Dialogue: 0,0:08:10.87,0:08:11.80,Default,,0,0,0,,너무 멋있다
Dialogue: 0,0:08:12.00,0:08:12.64,Default,,0,0,0,,저도 이런 거
Dialogue: 0,0:08:12.69,0:08:13.84,Default,,0,0,0,,좋아하는데 변태인가요?
Dialogue: 0,0:08:13.89,0:08:15.20,Default,,0,0,0,,이건 진짜 변태!
Dialogue: 0,0:08:15.25,0:08:15.82,Default,,0,0,0,,이건!
Dialogue: 0,0:08:15.87,0:08:16.92,Default,,0,0,0,,이건 진짜 변태!
Dialogue: 0,0:08:16.97,0:08:17.25,Default,,0,0,0,,이건 진짜 변태!
