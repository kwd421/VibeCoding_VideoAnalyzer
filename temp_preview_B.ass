Dialogue: 0,0:00:30.00,0:00:32.90,Default,,0,0,0,,안해왔냐?
Dialogue: 0,0:00:51.83,0:00:53.04,Default,,0,0,0,,독하
Dialogue: 0,0:00:55.32,0:00:57.18,Default,,0,0,0,,오 그래 보고 싶었다
Dialogue: 0,0:01:01.66,0:01:03.49,Default,,0,0,0,,목이 빠지는 줄 알았다
Dialogue: 0,0:01:06.91,0:01:09.37,Default,,0,0,0,,숨막혀 일어나
Dialogue: 0,0:01:11.84,0:01:12.79,Default,,0,0,0,,서방님 왔지 뭐
Dialogue: 0,0:01:19.07,0:01:21.40,Default,,0,0,0,,수세민이 모셨습니까?
Dialogue: 0,0:01:23.51,0:01:25.40,Default,,0,0,0,,아싸 쿰쿰이옴
Dialogue: 0,0:01:27.78,0:01:30.09,Default,,0,0,0,,어 그래 나도 보고 싶었어
Dialogue: 0,0:01:32.20,0:01:33.16,Default,,0,0,0,,왔냐?
Dialogue: 0,0:01:35.59,0:01:36.49,Default,,0,0,0,,안녕 독쌤
Dialogue: 0,0:01:42.53,0:01:43.70,Default,,0,0,0,,쿵쿵한 밤 되세요
Dialogue: 0,0:01:49.80,0:01:52.46,Default,,0,0,0,,합풍 좋나 크게 하네
Dialogue: 0,0:01:54.91,0:01:56.94,Default,,0,0,0,,숨막힌다고 해도 목을 안 놔주네
Dialogue: 0,0:01:57.04,0:02:00.54,Default,,0,0,0,,아! 얘네가 왜 이러나 했다
Dialogue: 0,0:02:00.76,0:02:02.72,Default,,0,0,0,,아 개띠가
Dialogue: 0,0:02:04.60,0:02:06.77,Default,,0,0,0,,아 개띠가 그런 거였어
Dialogue: 0,0:02:06.82,0:02:08.76,Default,,0,0,0,,아 얘네가 왜 이러나
Dialogue: 0,0:02:09.18,0:02:09.88,Default,,0,0,0,,우부부
Dialogue: 0,0:02:10.34,0:02:10.88,Default,,0,0,0,,아!
Dialogue: 0,0:02:12.74,0:02:14.14,Default,,0,0,0,,케이가 나 땀에 질게
Dialogue: 0,0:02:14.24,0:02:16.90,Default,,0,0,0,,하하 얘들아 내가 그렇게 반가운 거야
Dialogue: 0,0:02:17.08,0:02:17.99,Default,,0,0,0,,오늘은 오자마자
Dialogue: 0,0:02:18.04,0:02:21.90,Default,,0,0,0,,도내가 굉장히 많네 라고 생각하고 있었는데
Dialogue: 0,0:02:22.91,0:02:25.87,Default,,0,0,0,,아하하하 오늘 오자마자 도내가
Dialogue: 0,0:02:25.92,0:02:27.99,Default,,0,0,0,,이렇게 많다니 뭐지?
Dialogue: 0,0:02:28.79,0:02:32.70,Default,,0,0,0,,하하하하 뭘까나? 라고 생각했는데
Dialogue: 0,0:02:32.75,0:02:34.90,Default,,0,0,0,,다 이유가 있었잖아
Dialogue: 0,0:02:34.95,0:02:37.20,Default,,0,0,0,,아 그런 거였어 하핫
Dialogue: 0,0:02:37.25,0:02:41.54,Default,,0,0,0,,아 뭐야 내가 목 졸라서 튀어나온 거 였네
Dialogue: 0,0:02:41.59,0:02:44.17,Default,,0,0,0,,crus게 덜덜덜덜
Dialogue: 0,0:02:45.45,0:02:47.74,Default,,0,0,0,,아하 그냥 내가 싫어가지고 너무
Dialogue: 0,0:02:47.79,0:02:50.08,Default,,0,0,0,,좋아서 죽은 게 아니었던 거예요
Dialogue: 0,0:02:50.13,0:02:51.71,Default,,0,0,0,,거의 연례 행사지 뭐
Dialogue: 0,0:02:52.63,0:02:52.92,Default,,0,0,0,,아하
Dialogue: 0,0:02:52.97,0:02:55.72,Default,,0,0,0,,내가 너무 좋아서 주는 거예요
Dialogue: 0,0:02:55.78,0:02:57.89,Default,,0,0,0,,조금만 더 늦었으면 나쁜 구독
Dialogue: 0,0:02:57.94,0:03:00.23,Default,,0,0,0,,티콘을 마구마구 사용할 뻔했어요
Dialogue: 0,0:03:00.50,0:03:01.25,Default,,0,0,0,,안 돼! 안 돼요!
Dialogue: 0,0:03:01.97,0:03:03.01,Default,,0,0,0,,안 돼! 안 돼요!
Dialogue: 0,0:03:03.50,0:03:04.81,Default,,0,0,0,,아무튼 지가 아니에요
Dialogue: 0,0:03:07.12,0:03:09.88,Default,,0,0,0,,난 그런 줄도 모르고 그런 줄도 모르고
Dialogue: 0,0:03:09.93,0:03:13.30,Default,,0,0,0,,반갑빛 도내를 많이 할 정도 난이 정도
Dialogue: 0,0:03:13.35,0:03:15.91,Default,,0,0,0,,하 뭐야
Dialogue: 0,0:03:17.48,0:03:17.89,Default,,0,0,0,,나는
Dialogue: 0,0:03:18.82,0:03:20.68,Default,,0,0,0,,난 그런 줄도 모르고
Dialogue: 0,0:03:21.15,0:03:22.78,Default,,0,0,0,,내가 인기가 더 많아졌나?
Dialogue: 0,0:03:22.92,0:03:24.14,Default,,0,0,0,,10년 동안에?
Dialogue: 0,0:03:24.36,0:03:27.52,Default,,0,0,0,,라고 생각해버렸잖아
Dialogue: 0,0:03:27.86,0:03:30.40,Default,,0,0,0,,어? 나 인기가 많아졌나?
Dialogue: 0,0:03:30.69,0:03:33.18,Default,,0,0,0,,좋은데 화도 좀 나는 거지 뭐
Dialogue: 0,0:03:33.25,0:03:33.84,Default,,0,0,0,,나 어디
Dialogue: 0,0:03:35.25,0:03:37.11,Default,,0,0,0,,뭐 올라왔나?
Dialogue: 0,0:03:38.75,0:03:41.06,Default,,0,0,0,,나 어디 뭐 올라왔어?
Dialogue: 0,0:03:41.21,0:03:42.42,Default,,0,0,0,,갑작스러운 주목?
Dialogue: 0,0:03:42.71,0:03:47.58,Default,,0,0,0,,라고 생각했던 착각이었어 진짜
Dialogue: 0,0:03:48.36,0:03:49.59,Default,,0,0,0,,나 어디
Dialogue: 0,0:03:49.79,0:03:51.63,Default,,0,0,0,,나 어디 다이럴댄스
Dialogue: 0,0:03:52.91,0:03:55.35,Default,,0,0,0,,나 어디 잡혀 찍혔나?
Dialogue: 0,0:03:57.15,0:03:58.45,Default,,0,0,0,,기다리고 있었습니다
Dialogue: 0,0:03:59.17,0:04:02.29,Default,,0,0,0,,모시겠습니다 라고 생각했는데
Dialogue: 0,0:04:03.17,0:04:04.79,Default,,0,0,0,,아니었잖아
Dialogue: 0,0:04:06.53,0:04:08.39,Default,,0,0,0,,잡혀 찍혔다고?
Dialogue: 0,0:04:09.69,0:04:11.62,Default,,0,0,0,,기다리고 있었습니다
Dialogue: 0,0:04:11.85,0:04:13.51,Default,,0,0,0,,나 뭐 잘못했나?
Dialogue: 0,0:04:13.93,0:04:15.22,Default,,0,0,0,,또 영상 터졌나?
Dialogue: 0,0:04:16.07,0:04:20.42,Default,,0,0,0,,생각했는데 난 잘못을 안해서 그런 생각은 안했어
Dialogue: 0,0:04:20.70,0:04:23.28,Default,,0,0,0,,잘못을 안해서 그런 생각은 안했어
Dialogue: 0,0:04:23.64,0:04:24.98,Default,,0,0,0,,아무튼 케띵강
Dialogue: 0,0:04:30.98,0:04:34.68,Default,,0,0,0,,구독 아 미안 목 졸려서 구독이 씹혔어
Dialogue: 0,0:04:36.32,0:04:39.14,Default,,0,0,0,,우리 집 강아지는 불러 강아지
Dialogue: 0,0:04:39.76,0:04:41.37,Default,,0,0,0,,고맙다줘 고맙다줘
Dialogue: 0,0:04:41.42,0:04:43.45,Default,,0,0,0,,우리 집 강아지는
Dialogue: 0,0:04:44.16,0:04:45.99,Default,,0,0,0,,강현 기웅 김정수
Dialogue: 0,0:04:46.04,0:04:47.98,Default,,0,0,0,,조강현 송기웅
Dialogue: 0,0:04:49.00,0:04:50.72,Default,,0,0,0,,김정수 독해 입
Dialogue: 0,0:04:51.36,0:04:54.57,Default,,0,0,0,,조강현 송기웅 김정수 깨띠이 입
Dialogue: 0,0:04:55.10,0:04:56.38,Default,,0,0,0,,내 안에 입
Dialogue: 0,0:04:56.43,0:04:58.33,Default,,0,0,0,,그리운 사람들
Dialogue: 0,0:04:58.92,0:04:59.42,Default,,0,0,0,,머흑
Dialogue: 0,0:05:00.00,0:05:01.07,Default,,0,0,0,,우리의 고향
Dialogue: 0,0:05:05.37,0:05:06.29,Default,,0,0,0,,개쁘고
Dialogue: 0,0:05:06.34,0:05:07.49,Default,,0,0,0,,다음 달 출산 예정이에요
Dialogue: 0,0:05:07.54,0:05:08.72,Default,,0,0,0,,그만 타자 그만 타자
Dialogue: 0,0:05:08.77,0:05:09.10,Default,,0,0,0,,어?
Dialogue: 0,0:05:10.36,0:05:12.66,Default,,0,0,0,,개떡이도 다음 달 출산 예정이에요
Dialogue: 0,0:05:12.71,0:05:14.48,Default,,0,0,0,,아! 9개월이야 벌써
Dialogue: 0,0:05:14.53,0:05:15.39,Default,,0,0,0,,반갑다죠 반갑다죠
Dialogue: 0,0:05:15.77,0:05:17.58,Default,,0,0,0,,아무튼 고맙다죠 고맙다죠
Dialogue: 0,0:05:17.63,0:05:19.86,Default,,0,0,0,,다이나믹스 개떡이도 우리 집
Dialogue: 0,0:05:19.91,0:05:21.57,Default,,0,0,0,,강아지는 구독 강아지
Dialogue: 0,0:05:22.03,0:05:23.44,Default,,0,0,0,,고맙다죠 고맙다죠
Dialogue: 0,0:05:23.50,0:05:26.75,Default,,0,0,0,,그 다음에 엠다리도 고맙다죠 고맙다죠
Dialogue: 0,0:05:26.80,0:05:29.57,Default,,0,0,0,,우리 집 강아지는 구독시오님
Dialogue: 0,0:05:30.12,0:05:31.56,Default,,0,0,0,,고맙다죠 고맙다죠
Dialogue: 0,0:05:31.75,0:05:33.59,Default,,0,0,0,,그리고 개떡이 견이도
Dialogue: 0,0:05:33.71,0:05:35.34,Default,,0,0,0,,우리 집 강아지는
Dialogue: 0,0:05:35.39,0:05:37.34,Default,,0,0,0,,개떡이 견이 견이
Dialogue: 0,0:05:37.39,0:05:39.09,Default,,0,0,0,,고맙다죠 고맙다죠
Dialogue: 0,0:05:40.80,0:05:41.58,Default,,0,0,0,,웃어 웃어
Dialogue: 0,0:05:41.63,0:05:42.31,Default,,0,0,0,,오우
Dialogue: 0,0:05:42.36,0:05:43.78,Default,,0,0,0,,으으으
Dialogue: 0,0:05:43.83,0:05:44.69,Default,,0,0,0,,아우
Dialogue: 0,0:05:45.56,0:05:45.79,Default,,0,0,0,,어후
Dialogue: 0,0:05:45.84,0:05:46.05,Default,,0,0,0,,어후
Dialogue: 0,0:05:46.88,0:05:47.75,Default,,0,0,0,,아아
Dialogue: 0,0:05:47.81,0:05:49.73,Default,,0,0,0,,삼먹고 악영영의 케이기도
Dialogue: 0,0:05:49.78,0:05:50.63,Default,,0,0,0,,16개월 구독
Dialogue: 0,0:05:50.68,0:05:51.26,Default,,0,0,0,,아!
Dialogue: 0,0:05:51.82,0:05:52.97,Default,,0,0,0,,떡이랄
Dialogue: 0,0:05:53.02,0:05:54.03,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:54.08,0:05:54.93,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:54.99,0:05:56.23,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:56.28,0:05:56.87,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:56.93,0:05:57.50,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:57.55,0:05:58.31,Default,,0,0,0,,고맙다 줘
Dialogue: 0,0:05:58.56,0:05:59.11,Default,,0,0,0,,어후
Dialogue: 0,0:05:59.16,0:06:00.68,Default,,0,0,0,,아니 필라테스 갔다가
Dialogue: 0,0:06:00.73,0:06:02.53,Default,,0,0,0,,알차게 낮잠까지
Dialogue: 0,0:06:02.58,0:06:05.13,Default,,0,0,0,,알차게 낮잠
Dialogue: 0,0:06:05.18,0:06:05.97,Default,,0,0,0,,낮잠이 아니라
Dialogue: 0,0:06:06.02,0:06:07.15,Default,,0,0,0,,1시간 쪽잠까지
Dialogue: 0,0:06:07.20,0:06:08.66,Default,,0,0,0,,꿀잠 자고 왔어
Dialogue: 0,0:06:09.10,0:06:13.00,Default,,0,0,0,,1시간 족잠 대충 자고 왔어
Dialogue: 0,0:06:13.13,0:06:16.33,Default,,0,0,0,,7시 10분인가 집에 도착해가지고
Dialogue: 0,0:06:16.98,0:06:19.28,Default,,0,0,0,,조금 예정보다 일찍 할까 했는데
Dialogue: 0,0:06:19.33,0:06:22.38,Default,,0,0,0,,잠깐 침대에 누웠더니 갑자기 스르륵
Dialogue: 0,0:06:22.43,0:06:24.06,Default,,0,0,0,,이렇게 기절해가지고
Dialogue: 0,0:06:24.87,0:06:25.51,Default,,0,0,0,,어
Dialogue: 0,0:06:26.04,0:06:27.72,Default,,0,0,0,,기절 필라테스 했어요
Dialogue: 0,0:06:27.87,0:06:30.64,Default,,0,0,0,,기절할 때까지 필라테스 했어요
Dialogue: 0,0:06:33.03,0:06:34.30,Default,,0,0,0,,아무튼 우리 집
Dialogue: 0,0:06:34.59,0:06:37.34,Default,,0,0,0,,강아지는 무르시엘라고 고맙다죠
Dialogue: 0,0:06:37.39,0:06:39.68,Default,,0,0,0,,고맙다죠 무르시엘라고 개뜩이도
Dialogue: 0,0:06:39.73,0:06:41.19,Default,,0,0,0,,구독강아지 고맙다죠
Dialogue: 0,0:06:41.61,0:06:47.18,Default,,0,0,0,,알래요 강아지도 8개월 귀 덜덜덜덜덜덜
Dialogue: 0,0:06:47.23,0:06:49.81,Default,,0,0,0,,우리 집 강아지는 구독 알래요
Dialogue: 0,0:06:49.91,0:06:53.87,Default,,0,0,0,,그리고 국내산 개띵이도 12개월 구독 억덕이를
Dialogue: 0,0:06:54.59,0:06:57.32,Default,,0,0,0,,고마워요 고마워요 까매졌어 까매졌어
Dialogue: 0,0:06:57.37,0:06:59.46,Default,,0,0,0,,침대에 포근한 호그에 불복해버렸구나
Dialogue: 0,0:06:59.51,0:07:01.31,Default,,0,0,0,,구독피컨 대충 나왔는데
Dialogue: 0,0:07:09.59,0:07:11.99,Default,,0,0,0,,그러고 보니 구독 티콘이 내충 나와가지고
Dialogue: 0,0:07:15.44,0:07:15.80,Default,,0,0,0,,와우
Dialogue: 0,0:07:32.46,0:07:33.58,Default,,0,0,0,,미용 미용 미용
Dialogue: 0,0:07:35.28,0:07:38.52,Default,,0,0,0,,어쨌든 개떡이들의 의견이 중요하니깐
Dialogue: 0,0:07:45.84,0:07:47.19,Default,,0,0,0,,조금 바뀌긴 할 건데
Dialogue: 0,0:07:47.25,0:07:47.87,Default,,0,0,0,,내용
Dialogue: 0,0:07:57.08,0:07:59.67,Default,,0,0,0,,음
Dialogue: 0,0:08:12.95,0:08:13.37,Default,,0,0,0,,몰래?
Dialogue: 0,0:08:14.48,0:08:17.61,Default,,0,0,0,,아무튼 그래서 펠라테스 갔다가
Dialogue: 0,0:08:17.66,0:08:19.84,Default,,0,0,0,,꿀잠까지 때리고 왔어
Dialogue: 0,0:08:21.08,0:08:23.79,Default,,0,0,0,,짜잔 이게 새로운 개띵이에요
Dialogue: 0,0:08:24.73,0:08:27.35,Default,,0,0,0,,새로운 개띠기 구독티콘 어떤데?
Dialogue: 0,0:08:28.40,0:08:29.65,Default,,0,0,0,,어떤 거 같은데?
Dialogue: 0,0:08:30.53,0:08:32.05,Default,,0,0,0,,맘에 들어 개띠가?
Dialogue: 0,0:08:34.69,0:08:36.03,Default,,0,0,0,,맘에 들어
Dialogue: 0,0:08:36.28,0:08:38.66,Default,,0,0,0,,몇 가지 수정 사항이 있긴 한데요
Dialogue: 0,0:08:38.71,0:08:41.33,Default,,0,0,0,,위에는 억덕이고 아래는 그냥 개띠이야
Dialogue: 0,0:08:47.04,0:08:49.07,Default,,0,0,0,,고증이라고?
Dialogue: 0,0:08:49.97,0:08:52.73,Default,,0,0,0,,와 나 완전 싸이월드 이모티콘 같아
Dialogue: 0,0:08:54.17,0:08:58.04,Default,,0,0,0,,고맙다줘 고맙다줘 우리집 강아지는
Dialogue: 0,0:08:58.09,0:09:02.40,Default,,0,0,0,,구독 감자 포테이터 고맙다줘 고맙다줘
Dialogue: 0,0:09:02.45,0:09:07.27,Default,,0,0,0,,별다월 개띠기도 24개월 구독 개띠기 승천
Dialogue: 0,0:09:08.96,0:09:12.49,Default,,0,0,0,,우리집 강아지는 구독 별다월
Dialogue: 0,0:09:12.54,0:09:14.69,Default,,0,0,0,,고맙다줘 고맙다줘
Dialogue: 0,0:09:15.02,0:09:18.27,Default,,0,0,0,,켁케이기도 구독 강아지 고마워요 고마워요
Dialogue: 0,0:09:18.32,0:09:21.44,Default,,0,0,0,,두루미도 메스 가껴도 우리 집
Dialogue: 0,0:09:21.49,0:09:25.66,Default,,0,0,0,,강아지는 구독 두루미 고맙다죠 고맙다죠
Dialogue: 0,0:09:25.74,0:09:30.69,Default,,0,0,0,,우리 집 강아지는 구독 메스 가껴
Dialogue: 0,0:09:30.74,0:09:33.24,Default,,0,0,0,,고맙다죠 고맙다죠
Dialogue: 0,0:09:34.28,0:09:37.81,Default,,0,0,0,,켁케이기도 우리 집 강아지는 구독
Dialogue: 0,0:09:37.86,0:09:40.65,Default,,0,0,0,,케이케이 고맙다죠 고맙다죠
Dialogue: 0,0:09:41.18,0:09:43.39,Default,,0,0,0,,우리 집 강아지는 훈타 강아지
Dialogue: 0,0:09:43.44,0:09:45.63,Default,,0,0,0,,11개월 구독했대요 고맙습니다요
Dialogue: 0,0:09:45.68,0:09:47.66,Default,,0,0,0,,아무튼 그랬어 귀엽지?
Dialogue: 0,0:09:48.29,0:09:50.20,Default,,0,0,0,,나 다음 달에 팬티였는데
Dialogue: 0,0:09:50.25,0:09:51.60,Default,,0,0,0,,안돼 팬티는 멀어졌어
Dialogue: 0,0:09:51.65,0:09:54.28,Default,,0,0,0,,뭐 큰 거 보여준다길래 가족들 다 데려왔는데
Dialogue: 0,0:09:54.33,0:09:58.01,Default,,0,0,0,,구독 티큰비가 가족 환호성 지르고 있다
Dialogue: 0,0:10:02.37,0:10:07.00,Default,,0,0,0,,아무튼 그 개띵이 대충 1 2 3 4 5 6
Dialogue: 0,0:10:07.26,0:10:10.34,Default,,0,0,0,,7 8 9 10 11 12 13 14인가?
Dialogue: 0,0:10:11.44,0:10:14.34,Default,,0,0,0,,2개월에 한 번씩 바뀌나? 3개월에 한 번씩 바뀌나?
Dialogue: 0,0:10:14.92,0:10:19.15,Default,,0,0,0,,1년 살먹하면 그 뒤로 업덕이인 척 가능한 거임
Dialogue: 0,0:10:19.97,0:10:22.29,Default,,0,0,0,,2개월인가? 3개월에 한 번씩 바뀌나?
Dialogue: 0,0:10:22.61,0:10:25.62,Default,,0,0,0,,어 3개월에 한 번씩 바뀌는 걸 뜻?
Dialogue: 0,0:10:26.12,0:10:28.76,Default,,0,0,0,,어 3개월 6개월 이런 식으로
Dialogue: 0,0:10:28.81,0:10:30.45,Default,,0,0,0,,설정되어 있어가지고
Dialogue: 0,0:10:30.50,0:10:32.87,Default,,0,0,0,,아무튼 그렇다 어때? 마음에 들어?
Dialogue: 0,0:10:33.10,0:10:35.00,Default,,0,0,0,,금태현 캠티기야
Dialogue: 0,0:10:35.48,0:10:38.72,Default,,0,0,0,,얘네 둘은 차이가 없어가지고
Dialogue: 0,0:10:39.02,0:10:41.36,Default,,0,0,0,,오른쪽 두 번째는 도쩡쿠인가요?
Dialogue: 0,0:10:41.98,0:10:44.52,Default,,0,0,0,,오른쪽에서 두 번째
Dialogue: 0,0:10:45.71,0:10:48.59,Default,,0,0,0,,얘 좀비야 얘는 좀비떡이야
Dialogue: 0,0:10:49.17,0:10:49.83,Default,,0,0,0,,어
Dialogue: 0,0:10:50.11,0:10:52.92,Default,,0,0,0,,이 빤스 뒤집어 쓴 태닝개떡이 뭐냐고
Dialogue: 0,0:10:52.97,0:10:54.40,Default,,0,0,0,,이건 억덕이콘
Dialogue: 0,0:10:54.45,0:10:57.57,Default,,0,0,0,,억덕이들은 태닝을 하고
Dialogue: 0,0:10:58.31,0:11:00.55,Default,,0,0,0,,개띡이들은 하얘
Dialogue: 0,0:11:00.61,0:11:02.55,Default,,0,0,0,,그렇게 했어
Dialogue: 0,0:11:03.03,0:11:03.74,Default,,0,0,0,,어때요?
Dialogue: 0,0:11:03.84,0:11:05.10,Default,,0,0,0,,나름 마음에 들어?
Dialogue: 0,0:11:05.32,0:11:06.32,Default,,0,0,0,,마음에 들어?
Dialogue: 0,0:11:06.56,0:11:10.22,Default,,0,0,0,,원래 이거 만들어줬던 개떡이가 장사 접었어
Dialogue: 0,0:11:12.62,0:11:14.95,Default,,0,0,0,,나는 지금 개띠기의 이 멍청한
Dialogue: 0,0:11:15.00,0:11:16.34,Default,,0,0,0,,얼굴도 좋거든요?
Dialogue: 0,0:11:16.56,0:11:18.82,Default,,0,0,0,,근데 영어 하던 개띠 장사 접었어
Dialogue: 0,0:11:19.21,0:11:21.23,Default,,0,0,0,,작업을 안 하는 것 같더라
Dialogue: 0,0:11:24.36,0:11:26.10,Default,,0,0,0,,장사 접었어
Dialogue: 0,0:11:26.76,0:11:29.47,Default,,0,0,0,,다시 핑크빤스 뒤집어쓰려면
Dialogue: 0,0:11:29.79,0:11:30.73,Default,,0,0,0,,먹떡이시나요?
Dialogue: 0,0:11:32.03,0:11:33.85,Default,,0,0,0,,아무튼 귀엽지 않아 근데?
Dialogue: 0,0:11:34.27,0:11:35.85,Default,,0,0,0,,그냥 개떡이도 귀엽지 않아?
Dialogue: 0,0:11:36.21,0:11:40.28,Default,,0,0,0,,최대한 차이 안 나게 뭐랄까
Dialogue: 0,0:11:40.33,0:11:43.67,Default,,0,0,0,,느낌만 다르도록 했어요
Dialogue: 0,0:11:46.14,0:11:48.09,Default,,0,0,0,,멋진 전 민트 반주가 좋아요
Dialogue: 0,0:11:48.14,0:11:50.12,Default,,0,0,0,,귀엽지요 귀엽지요
Dialogue: 0,0:11:50.64,0:11:52.50,Default,,0,0,0,,미쿠 펜스가 더 좋아
Dialogue: 0,0:11:53.38,0:11:55.53,Default,,0,0,0,,일반 떡이가 더 귀여운 것도 많아
Dialogue: 0,0:11:55.58,0:11:56.34,Default,,0,0,0,,맞아 맞아
Dialogue: 0,0:11:58.25,0:12:01.48,Default,,0,0,0,,선택할 수 있으면 좋겠다고 하니까 선택을 못해
Dialogue: 0,0:12:02.42,0:12:04.49,Default,,0,0,0,,아무튼 그렇게 했어
Dialogue: 0,0:12:04.54,0:12:07.05,Default,,0,0,0,,어때 추가된 게 여기서부터 여기까지
Dialogue: 0,0:12:07.10,0:12:08.53,Default,,0,0,0,,추가인가 그럴 거예요
Dialogue: 0,0:12:08.58,0:12:10.26,Default,,0,0,0,,4개인가?
Dialogue: 0,0:12:12.12,0:12:13.47,Default,,0,0,0,,아무튼 만들었어
Dialogue: 0,0:12:13.52,0:12:17.46,Default,,0,0,0,,그리고 구독티콘도 새로 또 만들기도 하고
Dialogue: 0,0:12:17.70,0:12:21.59,Default,,0,0,0,,또 그다음에 OGQ도 하나 더 할까
Dialogue: 0,0:12:21.64,0:12:25.17,Default,,0,0,0,,생각하고 있기도 하고 그렇습니다
Dialogue: 0,0:12:25.62,0:12:29.18,Default,,0,0,0,,아무튼 아무튼 아무튼요 내가 그
Dialogue: 0,0:12:29.23,0:12:31.78,Default,,0,0,0,,필라테스 갔다 와가지고
Dialogue: 0,0:12:32.94,0:12:34.66,Default,,0,0,0,,그것도 싹 했잖아
Dialogue: 0,0:12:34.71,0:12:39.25,Default,,0,0,0,,계정 하나 덮어서 그건 다른 구독하면 되는데
Dialogue: 0,0:12:39.30,0:12:40.63,Default,,0,0,0,,어까모지
Dialogue: 0,0:12:40.68,0:12:44.25,Default,,0,0,0,,그렇네 코니 마음에 들어 다른 구독을 해
Dialogue: 0,0:12:44.30,0:12:45.80,Default,,0,0,0,,일하는 내 안에 칭찬
Dialogue: 0,0:12:45.85,0:12:46.80,Default,,0,0,0,,다른 구독하면 되잖아
Dialogue: 0,0:12:47.69,0:12:49.27,Default,,0,0,0,,다른 구독을 하면 되는데
Dialogue: 0,0:12:49.81,0:12:52.56,Default,,0,0,0,,좋은 생각이다 개띡고
Dialogue: 0,0:12:54.05,0:12:56.01,Default,,0,0,0,,아무튼 아무튼 지간해요
Dialogue: 0,0:12:56.91,0:12:59.02,Default,,0,0,0,,나만 도넷소리 너무 큼
Dialogue: 0,0:12:59.07,0:13:01.53,Default,,0,0,0,,아! 맞다! 도넷소리 엄청 키워났었다!
Dialogue: 0,0:13:04.11,0:13:04.72,Default,,0,0,0,,어 맞자
Dialogue: 0,0:13:05.20,0:13:07.82,Default,,0,0,0,,내 소리 내가 일부러 키워놨었다
Dialogue: 0,0:13:08.67,0:13:09.17,Default,,0,0,0,,야
Dialogue: 0,0:13:09.70,0:13:12.26,Default,,0,0,0,,이야아아아
Dialogue: 0,0:13:16.10,0:13:20.21,Default,,0,0,0,,아무튼 그렇습니다 필택 갔다 왔어 야무지게 한 시간
Dialogue: 0,0:13:20.82,0:13:23.26,Default,,0,0,0,,족장까지 조진 사람이야 지금
Dialogue: 0,0:13:24.14,0:13:25.18,Default,,0,0,0,,아아앙!
Dialogue: 0,0:13:28.02,0:13:29.20,Default,,0,0,0,,저녁가도 와야지
Dialogue: 0,0:13:29.58,0:13:31.24,Default,,0,0,0,,전망 기둘리샘
Dialogue: 0,0:13:31.44,0:13:34.23,Default,,0,0,0,,장망 기다루
Dialogue: 0,0:13:39.30,0:13:40.39,Default,,0,0,0,,으어어어어
Dialogue: 0,0:13:42.64,0:13:43.90,Default,,0,0,0,,귤에 를 마
Dialogue: 0,0:13:45.02,0:13:45.57,Default,,0,0,0,,아아
